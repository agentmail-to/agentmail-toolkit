{
    "name": "agentmail-toolkit",
    "version": "0.18.0",
    "description": "AgentMail Toolkit",
    "scripts": {
        "build": "tsup",
        "prepublishOnly": "tsup",
        "test": "vitest run",
        "lint": "eslint .",
        "prettier": "prettier --write ."
    },
    "keywords": [
        "agentmail",
        "toolkit",
        "tools",
        "ai",
        "vercel",
        "langchain"
    ],
    "author": "AgentMail <support@agentmail.cc>",
    "license": "MIT",
    "homepage": "https://agentmail.to",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/agentmail-to/agentmail-toolkit.git"
    },
    "packageManager": "pnpm@10.6.4",
    "type": "module",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./ai-sdk": {
            "types": "./dist/ai-sdk.d.ts",
            "import": "./dist/ai-sdk.js",
            "require": "./dist/ai-sdk.cjs"
        },
        "./langchain": {
            "types": "./dist/langchain.d.ts",
            "import": "./dist/langchain.js",
            "require": "./dist/langchain.cjs"
        },
        "./mcp": {
            "types": "./dist/mcp.d.ts",
            "import": "./dist/mcp.js",
            "require": "./dist/mcp.cjs"
        },
        "./clawdbot": {
            "types": "./dist/clawdbot.d.ts",
            "import": "./dist/clawdbot.js",
            "require": "./dist/clawdbot.cjs"
        }
    },
    "dependencies": {
        "agentmail": "^0.5.49",
        "jszip": "^3.10.1",
        "unpdf": "^1.4.0",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "@mariozechner/pi-agent-core": "^0.50.1",
        "@modelcontextprotocol/sdk": "^1.31.0",
        "ai": "^6.0.0-beta.150",
        "langchain": "^1.2.0"
    },
    "peerDependenciesMeta": {
        "@mariozechner/pi-agent-core": {
            "optional": true
        },
        "@modelcontextprotocol/sdk": {
            "optional": true
        },
        "ai": {
            "optional": true
        },
        "langchain": {
            "optional": true
        }
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@langchain/core": "^1.1.8",
        "@mariozechner/pi-agent-core": "^0.50.1",
        "@sinclair/typebox": "^0.34.47",
        "@types/node": "^24.10.1",
        "ai": "6.0.224",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^16.5.0",
        "prettier": "3.5.3",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.48.1",
        "vitest": "^4.1.12",
        "vite": "8.3.4"
    },
    "pnpm": {
        "overrides": {
            "nanoid@5": "^5.1.16",
            "@hono/node-server": ">=2.1.3 <3",
            "@modelcontextprotocol/sdk": ">=1.31.0",
            "@protobufjs/utf8": ">=1.1.1",
            "@whiskeysockets/baileys": ">=7.0.0-rc12",
            "axios": ">=1.20.0",
            "basic-ftp": ">=6.2.1",
            "body-parser": ">=2.4.0 <3",
            "fast-uri@3": "^3.1.9",
            "fast-uri@4": "^4.1.5",
            "fast-xml-parser": ">=5.7.0",
            "flatted": ">=3.4.2",
            "follow-redirects": ">=1.16.1 <2",
            "form-data": ">=4.0.6",
            "hono": ">=4.13.11 <5",
            "ip-address": ">=10.7.4 <11",
            "js-yaml": ">=5.4.1 <6",
            "langsmith": ">=0.6.0",
            "linkify-it": ">=5.0.2",
            "markdown-it": ">=15.0.3 <16",
            "minimatch": ">=10.2.3",
            "path-to-regexp": ">=8.4.0",
            "picomatch": ">=4.0.4",
            "postcss": ">=8.5.23",
            "protobufjs": ">=7.5.6",
            "qs": ">=6.16.1 <7",
            "rollup": ">=4.59.0",
            "sharp": ">=0.35.5",
            "simple-git": ">=4.0.1",
            "tar": ">=7.5.18",
            "uuid": ">=11.1.1",
            "ws": ">=8.21.0",
            "langchain": ">=1.2.3 <1.3.0",
            "ajv": ">=8.18.0",
            "@eslint/eslintrc>ajv": "^6.14.0",
            "eslint>ajv": "^6.14.0",
            "@simple-git/argv-parser": ">=2.0.1",
            "proxy-addr": ">=2.0.8",
            "source-map-js": ">=1.2.2",
            "undici@7": ">=7.30.1 <8",
            "undici@8": ">=8.10.2 <9",
            "brace-expansion@1": ">=1.1.20 <2",
            "brace-expansion@2": ">=2.1.6 <3",
            "brace-expansion@5": ">=5.0.12 <6",
            "music-metadata": ">=11.16.0 <12",
            "@humanfs/node": "^0.16.8",
            "zod@4": ">=4.6.7 <5",
            "yaml@2": ">=2.8.3 <3",
            "vite": "8.3.4",
            "@mistralai/mistralai@1": "1.15.1",
            "@mistralai/mistralai>zod": "4.6.7"
        }
    }
}
